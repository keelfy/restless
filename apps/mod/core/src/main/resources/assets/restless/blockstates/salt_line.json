{
  "multipart": [
    {
      "apply": {
        "model": "restless:block/salt_line"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "restless:block/salt_line_arm",
        "y": 0
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "restless:block/salt_line_arm",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "restless:block/salt_line_arm",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "restless:block/salt_line_arm",
        "y": 270
      }
    }
  ]
}
